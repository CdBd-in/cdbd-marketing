# CdBd 데모 계정 자격증명 — 이 파일을 .env로 복사한 후 본인이 직접 채워주세요.
# ⚠️ .env 파일은 절대 git에 커밋되지 않습니다 (.gitignore에 등록됨)
# ⚠️ 평소 사용하는 메인 계정 X — 별도 데모/테스트 계정을 만들어주세요

CDBD_EMAIL=your-demo-account@example.com
CDBD_PASSWORD=your-demo-password

# 캡처 결과 저장 경로 (디폴트: ./cdbd-에디터 캡처본)
CAPTURE_OUTPUT_DIR=./cdbd-에디터 캡처본

# Playwright 옵션
HEADLESS=true       # false 로 두면 브라우저 창이 보임 — 디버깅 시 false 추천
SLOW_MO=0           # ms 단위 (느리게 실행 — 디버깅 시 500~1000)
